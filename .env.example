# Copy this file to .env and adjust the values to match your setup.

# ── Database (docker compose service: campushub_postgres) ──
DATABASE_URL="postgresql://campus_admin:supersecretpassword@localhost:5432/campushub_db?schema=public"

# ── Redis (docker compose service: campushub_redis) — used for auth sessions ──
REDIS_URL="redis://localhost:6379"

# ── Email transport for OTP codes ──
# With NO email vars set, OTP emails (including the 6-digit code) are printed to
# the dev-server terminal — no mail server needed. Uncomment ONE transport below
# for real delivery. Priority: Postal → generic SMTP → dev console.
#
# ── Postal (self-hosted transactional mail server) — primary transport ──
# Postal's SMTP credential is the server's API key (same value for user and pass).
#POSTAL_SMTP_HOST="127.0.0.1"
#POSTAL_SMTP_PORT="2525"
#POSTAL_SMTP_USER="<postal-server-api-key>"
#POSTAL_SMTP_PASS="<postal-server-api-key>"
#POSTAL_FROM_EMAIL="no-reply@yourdomain.com"
#POSTAL_FROM_NAME="Campus Club Platform"

# ── Generic SMTP (any provider) — fallback transport ──
#EMAIL_FROM="CampusHub <noreply@yourdomain.com>"
#SMTP_HOST="smtp.yourprovider.com"
#SMTP_PORT=587
#SMTP_SECURE=false            # true for 465 (SMTPS)
#SMTP_USER="your-smtp-user"
#SMTP_PASS="your-smtp-password"

# ── Cloudinary (optional for local dev — image uploads show a config hint when missing) ──
#NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
#NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-preset"
#CLOUDINARY_API_KEY="your-api-key"
#CLOUDINARY_API_SECRET="your-api-secret"
